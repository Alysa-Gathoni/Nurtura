# Copy this file to .env and fill in real values. Never commit .env.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to call the API from a browser (production).
# In development (DEBUG=True) any localhost port is allowed automatically.
CORS_ALLOWED_ORIGINS=

# PostgreSQL. Leave DB_NAME empty to fall back to SQLite for local checks.
DB_NAME=
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Load the SBERT model when the web server starts, so the first request is
# fast (1) or not (0). Unset: off when DEBUG=True, on otherwise. Management
# commands never load it either way.
NURTURA_MODEL_WARMUP=

# Email for the two-step login codes. Leave EMAIL_HOST empty in development:
# codes are then printed in the runserver output. To send real emails, fill
# these in with your provider's details (e.g. a Gmail app password).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=your_sender@example.com
EMAIL_HOST_PASSWORD=your_email_app_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Nurtura <your_sender@example.com>
