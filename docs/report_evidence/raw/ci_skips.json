{
  "per_job": {
    "Backend (Django, sqlite)": 5,
    "Backend (Django, postgresql)": 3
  },
  "conditions": [
    {
      "class": "RealSbertModelTests",
      "file": "backend/recommendations/test_embeddings.py:230",
      "runs_only_if": "settings.SBERT_MODEL_PATH.exists()",
      "reason": "SBERT model not downloaded (run setup_sbert.py); skipped in CI"
    },
    {
      "class": "ConcurrentPostTests",
      "file": "backend/recommendations/test_recommendations_api.py:737",
      "runs_only_if": "connection.vendor == \"postgresql\"",
      "reason": "Row locking needs PostgreSQL; SQLite serialises writes differently"
    },
    {
      "class": "RealModelRetrievalTests",
      "file": "backend/recommendations/test_retrieval.py:274",
      "runs_only_if": "settings.SBERT_MODEL_PATH.exists()",
      "reason": "SBERT model not downloaded (run setup_sbert.py); skipped in CI"
    },
    {
      "class": "RealModelSpotCheckTests",
      "file": "backend/recommendations/test_spot_check.py:169",
      "runs_only_if": "settings.SBERT_MODEL_PATH.exists()",
      "reason": "SBERT model not downloaded (run setup_sbert.py); skipped in CI"
    }
  ]
}
